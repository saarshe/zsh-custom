# Yarn/Package Management
alias y='yarn'
alias my='midgard-yarn'
alias yb="yarn build"
alias yba="yarn build:app"
alias ys="yarn start"
alias ysa="yarn start:app"
alias yt="yarn test"
alias ytw="yarn test:watch"

# Git
alias gc-="git checkout -"
alias ggc="git-garbage-collection"
alias gbs="git-branch-switch"
alias gmm="git merge master"
alias gs="git stash"
alias gsp="git stash pop"

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias grepo='go-to-repo'
alias e0='exit 0'

# Date/Time
alias now='date "+%Y-%m-%d %H:%M:%S"'
alias ts='date +%s'

# macOS Finder
alias showfiles='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'

# NPM
alias npv='npm-package-versions'

# Tools
alias pai="npx @wix/premium-ai-cli"
alias c="claude"
